    "test": "vitest run"
  },
  "dependencies": {
    "@bga/platform": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
