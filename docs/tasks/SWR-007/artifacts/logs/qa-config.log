packages:
  - apps/*
  # explicit: `packages/*` would also match the `packages/games` folder itself
  - packages/platform
  - packages/games/*

# pnpm does not run dependency install scripts by default (pnpm 11+: `allowBuilds`, replaces `onlyBuiltDependencies`).
# Prisma needs them to download its engines; SWC and better-sqlite3 (Prisma 7 SQLite adapter) need native binaries.
