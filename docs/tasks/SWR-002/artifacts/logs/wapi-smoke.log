#!/bin/bash
# W-API smoke: built API (dist) on PORT=3200 with a temp SQLite file (not the dev DB).
API="/Users/dimatitov/WebstormProjects/Game automa/apps/api"
DB="$1/smoke.db"; rm -f "$DB"
export DATABASE_URL="file:$DB" PORT=3200
cd "$API"
echo "\$ DATABASE_URL=file:<scratchpad>/smoke.db pnpm exec prisma migrate deploy"
pnpm exec prisma migrate deploy; echo "exit=$?"
echo "\$ PORT=3200 node dist/main.js &"
node dist/main.js > "$1/server.log" 2>&1 &
PID=$!
for i in $(seq 1 40); do curl -s -o /dev/null http://localhost:3200/api/health && break; sleep 0.25; done
B=http://localhost:3200/api
run() { echo; echo "\$ curl $*"; curl -s -w '\nHTTP %{http_code}\n' "$@"; echo "exit=$?"; }
run $B/health
echo; echo "\$ curl -X POST $B/games (empire vs ai)"
CREATE=$(curl -s -H 'Content-Type: application/json' -d '{"humanFaction":"empire","opponent":{"kind":"ai","difficulty":"hard"}}' $B/games -w '\n%{http_code}')
echo "$CREATE" | head -c 600; echo " ..."; echo "HTTP $(echo "$CREATE" | tail -1)"
ID=$(echo "$CREATE" | head -1 | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).gameId))')
echo "gameId=$ID"
echo; echo "\$ curl $B/games/$ID  (summary: version, phase, rebelBase, piece pc-01, hidden pc-21)"
curl -s $B/games/$ID -w '\n%{http_code}' > "$1/get.txt"
head -1 "$1/get.txt" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const v=JSON.parse(s);console.log(JSON.stringify({version:v.version,phase:v.phase,rebelBase:v.rebelBase,pc01:v.pieces.find(p=>p.id==="pc-01"),pc21:v.pieces.find(p=>p.id==="pc-21"),legalActions:v.legalActions.length}))})'
echo "HTTP $(tail -1 "$1/get.txt")"
echo "raw body contains hidden typeKey 'covert-cell': $(grep -c covert-cell "$1/get.txt")"
echo; echo "\$ curl -X POST $B/games/$ID/commands  MOVE pc-01 sys-aurelis→sys-brevora v1 (legal)"
curl -s -H 'Content-Type: application/json' -d '{"actor":"empire","expectedVersion":1,"command":{"type":"MOVE_PIECES","pieceIds":["pc-01"],"fromSystemId":"sys-aurelis","toSystemId":"sys-brevora"}}' $B/games/$ID/commands -w '\n%{http_code}' > "$1/move.txt"
head -1 "$1/move.txt" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const r=JSON.parse(s);console.log(JSON.stringify({ok:r.ok,version:r.view.version,pc01:r.view.pieces.find(p=>p.id==="pc-01").systemId,events:r.events}))})'
echo "HTTP $(tail -1 "$1/move.txt")"
run -H 'Content-Type: application/json' -d '{"actor":"empire","expectedVersion":1,"command":{"type":"ADVANCE_PHASE"}}' $B/games/$ID/commands
run -H 'Content-Type: application/json' -d '{"actor":"empire","expectedVersion":2,"command":{"type":"MOVE_PIECES","pieceIds":["pc-02"],"fromSystemId":"sys-aurelis","toSystemId":"sys-eskara"}}' $B/games/$ID/commands
run -H 'Content-Type: application/json' -d '{"actor":"empire","expectedVersion":2,"command":{"type":"ADVANCE_PHASE"}}' $B/games/no-such-game/commands
run $B/games/no-such-game
run -H 'Content-Type: application/json' -d '{"actor":"empire","expectedVersion":2,"command":{"type":"MOVE_PIECES","pieceIds":[]}}' $B/games/$ID/commands
run $B/games
echo; echo "\$ kill $PID (stop server)"
kill $PID; wait $PID 2>/dev/null; echo "server stopped"
curl -s -o /dev/null -w 'after stop: HTTP %{http_code}\n' http://localhost:3200/api/health
echo "server log:"; cat "$1/server.log"
rm -f "$DB" "$DB-journal"
