## TC-COST-04: migration + schema AiUsage columns
-- SWR-008 (AC-12, plan-backend §5): rules-context accounting columns of AiUsage (hand-written, data-preserving:
-- ADD COLUMN only, no table rebuild; the generated RedefineTables variant was replaced). Existing rows get the
-- "rules off" defaults; promptTokensUpperBound stays NULL for rows written before SWR-008.
-- Rule ids only (public KB ids as a JSON array) — never rule text, prompt text or the model's reason.
-- No down migration: roll back = restore a DB copy.
ALTER TABLE "AiUsage" ADD COLUMN "rulesEnabled" BOOLEAN NOT NULL DEFAULT false;
ALTER TABLE "AiUsage" ADD COLUMN "rulesVersion" TEXT;
ALTER TABLE "AiUsage" ADD COLUMN "rulesCount" INTEGER NOT NULL DEFAULT 0;
ALTER TABLE "AiUsage" ADD COLUMN "rulesIds" TEXT;
ALTER TABLE "AiUsage" ADD COLUMN "rulesChars" INTEGER NOT NULL DEFAULT 0;
ALTER TABLE "AiUsage" ADD COLUMN "rulesTokensEstimate" INTEGER NOT NULL DEFAULT 0;
ALTER TABLE "AiUsage" ADD COLUMN "rulesTruncated" BOOLEAN NOT NULL DEFAULT false;
ALTER TABLE "AiUsage" ADD COLUMN "rulesDropped" BOOLEAN NOT NULL DEFAULT false;
ALTER TABLE "AiUsage" ADD COLUMN "promptTokensUpperBound" INTEGER;
model AiUsage {
  id                    String   @id // UUID
  budgetKey             String
  provider              String // 'openai' | 'mock'
  model                 String // configured model id ('mock-deterministic-v1' for mock)
  role                  String // 'strategy' | 'tactical'
  /// 'ok' | 'invalid_decision' | 'timeout' | 'rate_limited' | 'provider_error' | 'not_configured' | 'budget_exceeded'
  status                String
  attempts              Int
  inputTokens           Int      @default(0)
  cachedInputTokens     Int      @default(0)
  outputTokens          Int      @default(0)
  reasoningTokens       Int?
  /// Estimated cost in integer micro-USD (1 USD = 1 000 000), Q-15: summed without float error.
  estimatedCostMicroUsd Int      @default(0)
  /// Version of the pricing table the estimate was computed with (AM-BE-7).
  pricingVersion        String
  durationMs            Int
  errorCode             String? // platform ErrorCode
  createdAt             DateTime @default(now())

  // SWR-008 (AC-12, plan-backend §5): rules context of the request. Never rule text, prompt text or the model's reason.
  /// SWR-008: rules context switched on for this request (AI_COMMANDER_RULES_CONTEXT=on, commander only).
  rulesEnabled           Boolean @default(false)
  /// Rules set version (`<gameId>@<formatVersion>:<hash12>`); null = off / the game has no rules / dev-test.
  rulesVersion           String?
  rulesCount             Int     @default(0)
  /// JSON array of the PUBLIC rule ids sent (never rule text); null when none.
  rulesIds               String?
  rulesChars             Int     @default(0)
  /// ceil(rulesChars / 4) — estimate; the real delta is measured by the benchmark.
  rulesTokensEstimate    Int     @default(0)
  rulesTruncated         Boolean @default(false)
  /// Removed by the prompt-size limit (QD-9).
  rulesDropped           Boolean @default(false)
  /// upperBoundInputTokens of the sent prompt (the reservation basis); null = before SWR-008.
  promptTokensUpperBound Int?

  @@index([budgetKey, createdAt])
}

