# scratch spec used (verbatim):
// QA scratch spec (SWR-008 TC-DIAG-08, browser QA). NOT part of the repo. Human Empire vs AI Rebels (bot server);
// switch on via the /dev/ai flag; the decisions endpoint is answered by page.route with a wire-valid fixture (real
// rule ids of the Rebellion KB, rulesVersion of the real KB); the next command response is patched to an OpenAI run
// with AI_PROMPT_TOO_LARGE. Screenshots: ru/en × 1440/375 into docs/tasks/SWR-008/artifacts/screenshots/.
import { expect, test, type Page, type Route } from '@playwright/test';
import {
  API,
  commandOk,
  createSession,
  EMPIRE_VS_AI,
  getCoreView,
  planActivation,
  type AutomationRunSummary,
  type CoreCommandResponse,
} from '/Users/dimatitov/WebstormProjects/Game automa/e2e/support/api.ts';
import { openCore } from '/Users/dimatitov/WebstormProjects/Game automa/e2e/support/board.ts';
import { finishViaUi } from '/Users/dimatitov/WebstormProjects/Game automa/e2e/support/core.ts';
import { enableTableDiagnostics, isSessionDecisionsGet } from '/Users/dimatitov/WebstormProjects/Game automa/e2e/support/dev-ai.ts';
import { T } from '/Users/dimatitov/WebstormProjects/Game automa/e2e/support/testids.ts';

const OUT = '/Users/dimatitov/WebstormProjects/Game automa/docs/tasks/SWR-008/artifacts/screenshots';
const VERSION = 'rebellion@1:55b423d7bfef';
const IDLE = [
  'rebellion:impl.engine-scope', 'rebellion:base.reveal-condition', 'rebellion:base.reveal-timing',
  'rebellion:command.activate.place-leader', 'rebellion:command.activate.steps',
  'rebellion:command.move.into-activated-from-adjacent', 'rebellion:command.move.own-leader-locks',
  'rebellion:command.pass', 'rebellion:command.transport.capacity', 'rebellion:command.transport.restriction-icon',
  'rebellion:command.turn-order', 'rebellion:round.structure', 'rebellion:victory.empire', 'rebellion:victory.rebels',
  'rebellion:command.activate.system-with-leader', 'rebellion:command.activate.tactic-values-required',
  'rebellion:base.death-star-does-not-reveal',
];
const ACTIVE = [
  'rebellion:impl.engine-scope', 'rebellion:base.reveal-condition', 'rebellion:base.reveal-timing',
  'rebellion:command.activate.place-leader', 'rebellion:command.activate.steps',
  'rebellion:command.move.into-activated-from-adjacent', 'rebellion:command.move.own-leader-locks',
  'rebellion:command.pass', 'rebellion:command.transport.capacity', 'rebellion:command.transport.restriction-icon',
  'rebellion:command.turn-order', 'rebellion:round.structure', 'rebellion:victory.empire', 'rebellion:victory.rebels',
  'rebellion:command.activate.zero-units', 'rebellion:command.move.adjacency', 'rebellion:command.move.immobile',
  'rebellion:base.death-star-does-not-reveal', 'rebellion:command.pass-is-not-action',
];
const rules = (ids: string[], chars: number, extra: Record<string, unknown> = {}) => ({
  enabled: true, rulesVersion: VERSION, count: ids.length, ids, chars, tokensEstimate: Math.ceil(chars / 4),
  truncated: false, dropped: false, ...extra,
});
const base = { provider: 'openai', model: 'gpt-6-luna', cachedInputTokens: 0 };
const DECISIONS = [
  { ...base, at: '2026-11-20T14:10:01.000Z', status: 'ok', fallback: false, errorCode: null, attempts: 1,
    inputTokens: 2431, outputTokens: 49, costMicroUsd: 268, durationMs: 1377, rules: rules(IDLE, 5070) },
  { ...base, at: '2026-11-20T14:10:04.000Z', status: 'timeout', fallback: true, errorCode: 'AI_TIMEOUT', attempts: 3,
    inputTokens: 0, outputTokens: 0, costMicroUsd: 0, durationMs: 15000, rules: rules(ACTIVE, 5393) },
  { ...base, at: '2026-11-20T14:10:06.000Z', status: 'ok', fallback: false, errorCode: null, attempts: 1,
    inputTokens: 1088, outputTokens: 53, costMicroUsd: 136, durationMs: 3475,
    rules: { ...rules([], 0), dropped: true } },
];
const group = (rows: typeof DECISIONS) => {
  const cost = rows.reduce((s, d) => s + d.costMicroUsd, 0);
  return {
    decisions: rows.length, costMicroUsd: cost,
    inputTokens: rows.reduce((s, d) => s + d.inputTokens, 0),
    outputTokens: rows.reduce((s, d) => s + d.outputTokens, 0),
    meanCostMicroUsd: rows.length ? cost / rows.length : null,
  };
};
const BODY = {
  decisions: DECISIONS,
  totals: {
    withRules: group(DECISIONS.filter((d) => d.rules.count > 0 && !d.rules.dropped)),
    withoutRules: group(DECISIONS.filter((d) => !(d.rules.count > 0 && !d.rules.dropped))),
    total: group(DECISIONS),
  },
};

async function patchNextCommand(page: Page, patch: (a: AutomationRunSummary) => AutomationRunSummary) {
  await page.route((url) => API.commands.test(url.pathname), async (route: Route) => {
    const res = await route.fetch();
    const body = (await res.json()) as CoreCommandResponse;
    if (res.status() === 200) body.automation = patch(body.automation);
    await route.fulfill({ response: res, json: body });
  }, { times: 1 });
}

for (const lang of ['ru', 'en'] as const) {
  for (const width of [1440, 375] as const) {
    test(`TC-DIAG-08 dev panel ${lang} ${width}`, async ({ page, request }) => {
      await page.setViewportSize({ width, height: width === 375 ? 812 : 900 });
      await enableTableDiagnostics(page);
      await page.goto('/settings');
      await page.getByTestId(T.settingsLanguage(lang)).click();
      await expect(page.locator('html')).toHaveAttribute('lang', lang);
      let gets = 0;
      await page.route((url) => /\/api\/dev\/ai\/sessions\/[^/]+\/decisions$/.test(url.pathname), async (route) => {
        gets += 1;
        await route.fulfill({ status: 200, json: BODY });
      });
      const { sessionId } = await createSession(request, EMPIRE_VS_AI);
      const view = await getCoreView(request, sessionId);
      const plan = planActivation(view);
      await commandOk(request, sessionId, view, { type: 'ACTIVATE_SYSTEM', leaderId: plan.leaderId, systemId: plan.systemId });
      await openCore(page, sessionId);
      await patchNextCommand(page, (a) => ({ ...a, strategy: 'openai', fallbacks: 1, fallbackReasons: ['AI_PROMPT_TOO_LARGE'] }));
      const fin = await finishViaUi(page);
      expect(fin.body.automation.steps).toBeGreaterThanOrEqual(1);
      const panel = page.getByTestId(T.devAiSessionDiagnostics);
      await expect(panel).toHaveAttribute('data-state', 'ready');
      await expect(panel).toHaveAttribute('data-decisions', '3');
      await page.getByTestId(T.devAiSessionToggle).click();
      await expect(panel).toHaveAttribute('data-expanded', 'true');
      await expect(page.getByTestId(T.devAiSessionLastRun)).toHaveAttribute('data-reasons', /AI_PROMPT_TOO_LARGE/);
      const d1 = page.getByTestId(T.devAiSessionDecision(0)).or(page.getByTestId(T.devAiSessionDecision(1))).first();
      await expect(d1).toBeVisible();
      await page.waitForTimeout(400);
      const panelText = await panel.innerText();
      const html = await page.content();
      // what is visible in the panel
      console.log(`[qa-diag08] ${lang} ${width} gets=${gets} panelText=${JSON.stringify(panelText)}`);
      // hidden / internal data: never the session id (budget key), prompt / situation / reason, never a system id
      const systemIds = (await getCoreView(request, sessionId)).map.systems.map((s) => s.id);
      expect(panelText).not.toContain(sessionId);
      expect(await panel.innerHTML()).not.toContain(sessionId);
      const where = await page.evaluate((id) => {
        const out: string[] = [];
        const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        for (let n = w.nextNode(); n; n = w.nextNode()) {
          if (n.textContent?.includes(id)) {
            const el = n.parentElement;
            const tid = el?.closest('[data-testid]')?.getAttribute('data-testid');
            out.push(`${el?.tagName}#testid=${tid} visible=${el ? el.getClientRects().length > 0 : false}`);
          }
        }
        return out;
      }, sessionId);
      console.log(`[qa-diag08] ${lang} ${width} sessionIdTextNodesOutsidePanel=${JSON.stringify(where)} htmlHasId=${html.includes(sessionId)}`);
      expect(panelText).not.toMatch(/situation|reason|budget|session|Game \(data\)|Rules \(reference data|Your forces|Possible base locations/i);
      const leakedSystems = systemIds.filter((id) => new RegExp(`(^|[^a-z-])${id}([^a-z-]|$)`).test(panelText));
      console.log(`[qa-diag08] ${lang} ${width} systemIdsInPanel=${JSON.stringify(leakedSystems)} rebelBaseInEmpireView=${JSON.stringify(fin.view.rebelBase)}`);
      expect(leakedSystems).toEqual([]);
      for (const id of IDLE) expect(panelText).toContain(id);
      await page.screenshot({ path: `${OUT}/swr008-dev-diagnostics-${lang}-${width}.png`, fullPage: false });
      await panel.screenshot({ path: `${OUT}/swr008-dev-diagnostics-panel-${lang}-${width}.png` });
      for (const n of ['19', '17']) {
        const row = page.locator(`[data-testid^="dev-ai-session-decision-"][data-rules-count="${n}"]`);
        await expect(row).toHaveCount(1);
        console.log(`[qa-diag08] ${lang} ${width} row rules=${n} attrs=${JSON.stringify(await row.evaluate((el) => Object.fromEntries([...el.attributes].filter((a) => a.name.startsWith('data-')).map((a) => [a.name, a.value]))))}`);
        await row.scrollIntoViewIfNeeded();
        await page.waitForTimeout(200);
        await panel.screenshot({ path: `${OUT}/swr008-dev-diagnostics-panel-rules${n}-${lang}-${width}.png` });
      }
    });
  }
}
