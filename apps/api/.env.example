# Copied to .env by `pnpm --filter @bga/api run db:prepare` (part of `pnpm dev`) if .env is missing.
# Validated at startup by one Zod schema (src/config/env.ts); an invalid value stops the API with exit code 1.
# A blank value is the same as an unset variable.
# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
PORT=3000
# development | test | production (dev-only routes exist only when != production; test never reads .env)
NODE_ENV=development
# true -> real OpenAI requests (paid). false -> MockAIProvider only; the OPENAI_* below are then not checked.
OPENAI_ENABLED=false
# Server-only secret. Never commit a real key; put it into apps/api/.env yourself.
OPENAI_API_KEY=
OPENAI_STRATEGY_MODEL=gpt-6.1-sol
OPENAI_TACTICAL_MODEL=gpt-6-luna
# Required when OPENAI_ENABLED=true: number > 0 and <= 5 (USD per budget key).
OPENAI_MAX_COST_PER_SESSION_USD=0.25
# 1000..120000
OPENAI_TIMEOUT_MS=30000
# 0..5
OPENAI_MAX_RETRIES=2
# AI commander of sessions against the AI (SWR-006). Checked always, independent of OPENAI_ENABLED.
# bot (default, free, deterministic) | openai (requires OPENAI_ENABLED=true; spends up to
# OPENAI_MAX_COST_PER_SESSION_USD per session; any OpenAI failure falls back to the bot).
AI_COMMANDER_PROVIDER=bot
# tactical | strategy — which OPENAI_*_MODEL the openai commander uses.
AI_COMMANDER_MODEL_ROLE=tactical
# AI steps per automation run, 1..256 (a longer AI turn continues on the next run).
AI_COMMANDER_MAX_STEPS=64
# Time budget for OpenAI calls in one run, ms, 1000..120000 (after it the bot finishes the run).
AI_COMMANDER_RUN_DEADLINE_MS=45000
# SWR-008: rules knowledge for the openai commander. on (default) | off (case-sensitive). With
# AI_COMMANDER_PROVIDER=openai and on, the server loads and validates the game's rules knowledge base once at
# start (a broken base stops the API); the bot never uses rules.
AI_COMMANDER_RULES_CONTEXT=on
# Size limit of the rules block, characters, 1000..12000 (must also fit the game's mandatory engine-scope line).
AI_COMMANDER_RULES_MAX_CHARS=6000
# Limit of one AI request, 4000..64000, in upper-bound input tokens (UTF-8 bytes of instructions + input + schema
# + 256). A larger prompt drops the rules first; if it still does not fit, the bot decides (AI_PROMPT_TOO_LARGE).
AI_COMMANDER_MAX_PROMPT_TOKENS=16000
