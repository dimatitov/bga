# Copied to .env by `pnpm --filter @bga/api run db:prepare` (part of `pnpm dev`) if .env is missing.
# Validated at startup by one Zod schema (src/config/env.ts); an invalid value stops the API with exit code 1.
# A blank value is the same as an unset variable.
# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
PORT=3000
# development | test | production (dev-only routes exist only when != production; test never reads .env)
NODE_ENV=development
# true -> real OpenAI requests (paid). false -> MockAIProvider only; the OPENAI_* below are then not checked.
OPENAI_ENABLED=false
# Server-only secret. Never commit a real key; put it into apps/api/.env yourself.
OPENAI_API_KEY=
OPENAI_STRATEGY_MODEL=gpt-6.1-sol
OPENAI_TACTICAL_MODEL=gpt-6-luna
# Required when OPENAI_ENABLED=true: number > 0 and <= 5 (USD per budget key).
OPENAI_MAX_COST_PER_SESSION_USD=0.25
# 1000..120000
OPENAI_TIMEOUT_MS=30000
# 0..5
OPENAI_MAX_RETRIES=2
