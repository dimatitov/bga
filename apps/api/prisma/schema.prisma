generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A saved play of one game (SWR-003). `gameId` is a catalogue id (`GameDefinition.id`).
model Session {
  id              String         @id
  gameId          String
  setup           String // JSON: the game's setup (output form)
  state           String // JSON: full game state — NEVER sent to clients (only the player's view)
  version         Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// SessionStatus of @bga/platform ('setup' | 'prototype' | 'active' | 'completed'); the value comes from the
  /// game module (`initialStatus`). The DEFAULT only backfills rows created before SWR-004.
  status          String         @default("prototype")
  /// `Idempotency-Key` of the POST that created the session (Q-25: kept forever); null = created without a key.
  idempotencyKey  String?        @unique
  /// SHA-256 (hex) of the canonical JSON `{gameId, setup}` of that POST (Q-2, AM-BE-4).
  idempotencyHash String?
  events          SessionEvent[]

  @@index([gameId, updatedAt])
  @@index([updatedAt])
}

/// Append-only mirror of the game's event log, written in the same transaction as the snapshot (A-15).
model SessionEvent {
  id        Int      @id @default(autoincrement())
  sessionId String
  seq       Int
  type      String
  actor     String
  payload   String // JSON
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
}

/// One AI decision attempt (SWR-005B): token usage and ESTIMATED cost. A row is written for every attempt —
/// successful, failed, mock (cost 0) and budget refusals (`budget_exceeded`, 0 attempts) — AM-BE-7.
/// Never stores prompt or response text (no such columns on purpose).
model AiUsage {
  id                    String   @id // UUID
  budgetKey             String
  provider              String // 'openai' | 'mock'
  model                 String // configured model id ('mock-deterministic-v1' for mock)
  role                  String // 'strategy' | 'tactical'
  /// 'ok' | 'invalid_decision' | 'timeout' | 'rate_limited' | 'provider_error' | 'not_configured' | 'budget_exceeded'
  status                String
  attempts              Int
  inputTokens           Int      @default(0)
  cachedInputTokens     Int      @default(0)
  outputTokens          Int      @default(0)
  reasoningTokens       Int?
  /// Estimated cost in integer micro-USD (1 USD = 1 000 000), Q-15: summed without float error.
  estimatedCostMicroUsd Int      @default(0)
  /// Version of the pricing table the estimate was computed with (AM-BE-7).
  pricingVersion        String
  durationMs            Int
  errorCode             String? // platform ErrorCode
  createdAt             DateTime @default(now())

  @@index([budgetKey, createdAt])
}
