{
  "name": "@bga/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "db:prepare": "node scripts/ensure-env.mjs && prisma generate && prisma migrate deploy",
    "e2e:serve": "node scripts/e2e-serve.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "@bga/game-forbidden-stars": "workspace:*",
    "@bga/game-rebellion": "workspace:*",
    "@bga/platform": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
